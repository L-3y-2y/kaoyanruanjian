# 只写键名，不写真值。真正的文件是 backend/.env（已在 .gitignore 中排除）。
# 目前 backend/.env 已从旧演示项目复制过来，含可用的 kaoyan_app 凭据。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kaoyanruanjian
DB_USER=kaoyan_app
DB_PASSWORD=

# 账号：1 = 未登录时允许本机回环地址继续使用占位账号（保留旧进度）；0 = 强制登录
LOCAL_MODE=1

# 安全边界（对外部署才需要改）：
# ALLOW_LOCAL_ADMIN = 是否允许本机回环请求直接用「词库管理」。默认跟随 LOCAL_MODE；
#   若把应用放到反向代理后面或监听 0.0.0.0，务必显式设为 0（带 X-Forwarded-* 的请求
#   已被代码一律拒绝当作本机）。COOKIE_SECURE = HTTPS 部署时设为 1，本地 http 保持 0。
ALLOW_LOCAL_ADMIN=
COOKIE_SECURE=0

# 免费大模型：主通道用智谱（国内直连、OpenAI 兼容）；兜底保留 Agnes。
# 两者都不填就走本地确定性生成器。
# 获取智谱 Key：https://open.bigmodel.cn → 控制台 → API Keys（手机号注册，无需绑卡）。
# base_url 填 OpenAI 兼容接口根地址，脚本会拼 /chat/completions。
# 模型名建议 glm-4-flash：老牌永久免费、实测稳定。glm-4.7-flash 虽也免费，
# 但晚高峰常返回 429「访问量过大」，故不作默认。
# 界面「模型」面板只在这份白名单里切换（逗号分隔）；加新模型改这里即可，无需改代码。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_MODEL_PRESETS=glm-4-flash,glm-4.5-flash,glm-4.7-flash
LLM_FALLBACK_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=agnes-3.0-flash
LLM_TIMEOUT=12

# 可选间隔复习（艾宾浩斯式 1/2/4/7/15/30 天）。默认 0 = 完全保持原「按日期批次、无到期提醒」行为。
# 改成 1 才会写 next_due_at 并在复习页显示「今日该复习」卡片；不会改轮次状态、不会推送提醒。
SMART_REVIEW=0

# 英语 AI 助手：最多轮数与每次回复的 token 上限。默认 8 轮 / 512 token，
# 够用于中英互译、查词带例句、语法讲解；想更省 token 可调小。
# 出题/批改（考研风格完形、阅读、翻译、作文）会自动用更高的 CHAT_PRACTICE_TOKENS。
CHAT_MAX_TURNS=8
CHAT_MAX_TOKENS=512
CHAT_PRACTICE_TOKENS=1200
# 出题要写长文章和题目，单请求超时单独放宽（普通对话仍用 LLM_TIMEOUT=12）。
CHAT_PRACTICE_TIMEOUT=60
